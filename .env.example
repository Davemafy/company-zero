# Deliverable Engine. Uses the same Supabase project; no new third-party key.
CZ_ARTIFACT_BUCKET=company-zero-artifacts
CZ_SESSION_SECRET=
CZ_ALLOW_LEGACY_ARTIFACT_ACCESS=false

# Company Zero dual-provider model gateway.
# TensorMux is preferred for cheap planning and routine/reversible execution.
TENSORMUX_BASE_URL=
TENSORMUX_API_KEY=
TENSORMUX_TIMEOUT_MS=60000
TENSORMUX_PLANNER_MODEL=glm-4-7-flash
TENSORMUX_EXECUTION_MODEL=glm-4-7-flash

# AgentRouter handles specialist execution, frontier escalation and independent verification.
AGENTROUTER_BASE_URL=
AGENTROUTER_API_KEY=
AGENTROUTER_TIMEOUT_MS=60000
AGENTROUTER_SPECIALIST_MODEL=glm-5.3
AGENTROUTER_FRONTIER_MODEL=claude-opus-5
AGENTROUTER_VERIFIER_MODEL=gpt-5.6-sol

