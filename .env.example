SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_TOKEN=

# Deliverable Engine. Uses the same Supabase project; no new third-party key.
CZ_ARTIFACT_BUCKET=company-zero-artifacts
# Optional dedicated cookie-signing secret. If omitted, the server derives signing from the Supabase service-role secret.
CZ_SESSION_SECRET=
# Only for deliberate migration of old unowned artifacts; keep false for normal production.
CZ_ALLOW_LEGACY_ARTIFACT_ACCESS=false

TENSORMUX_BASE_URL=
TENSORMUX_API_KEY=
TENSORMUX_MODEL=
TENSORMUX_RUNTIME_MODEL=

NEATLOGS_WRITE_KEY=
NEATLOGS_PROJECT=company-zero
NEATLOGS_INGEST_URL=https://ingest.neatlogs.com

# Preferred no-card public-web observation path using GitHub Student Pack Scrapy Cloud.
SCRAPY_CLOUD_API_KEY=
SCRAPY_CLOUD_PROJECT_ID=877155
SCRAPY_CLOUD_SPIDER=generic_observer
SCRAPY_CLOUD_POLL_MS=1000
SCRAPY_CLOUD_POLL_WINDOW_MS=120000
SCRAPY_CLOUD_ESTIMATED_COST_USD=0

# Optional paid Zyte API adapter; not required when Scrapy Cloud is configured.
ZYTE_API_KEY=
ZYTE_API_URL=https://api.zyte.com/v1/extract

WORKER_ID=company-zero-railway-1
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=1000
WORKER_MAX_BACKOFF_MS=30000

# Optional independent public HTTP verifier for controlled production missions.
PUBLIC_HTTP_PROBE_ENABLED=false

# Optional bounded real-world action provider for controlled repository missions.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Outcome-control production verification
# Independent webpage measurement via Google PageSpeed Insights.
PAGESPEED_ENABLED=false
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_MS=60000

# Optional Vercel deployment verification. Use scoped project/team credentials.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_TIMEOUT_MS=180000
VERCEL_DEPLOY_POLL_MS=4000

# Production golden-path verifier. The verifier now preserves its owner-session cookie,
# auto-approves only approvals belonging to the fresh verification session, and exits non-zero on FAIL.
COMPANY_ZERO_BASE_URL=
CZ_GOLDEN_GOAL=Improve the measurable performance of this deployed webpage without breaking it.
CZ_GOLDEN_CONTEXT_JSON={}
CZ_GOLDEN_CONSTRAINTS_JSON={"dailyBudgetUsd":1}
CZ_GOLDEN_TIMEOUT_MS=720000
CZ_GOLDEN_AUTO_APPROVE=false

# Legacy unowned companies are denied by the production API unless deliberately enabled for migration.
CZ_ALLOW_LEGACY_COMPANY_ACCESS=false
